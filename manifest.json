{
  "manifest_version": 3,
  "name": "Ruler",
  "version": "0.1.0",
  "description": "Chrome extension for page ruler, protractor, eyedropper, distance measurement, grid, and size inspection workflows.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/assets/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/assets/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Ruler",
    "default_popup": "dist/popup.html"
  },
  "icons": {
    "16": "assets/ruler-icon.jpg",
    "48": "assets/ruler-icon.jpg",
    "128": "assets/ruler-icon.jpg"
  },
  "web_accessible_resources": [{
    "resources": ["dist/assets/*"],
    "matches": ["<all_urls>"]
  }]
}
