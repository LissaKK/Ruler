{
  "manifest_version": 3,
  "name": "Ruler",
  "version": "0.1.0",
  "description": "Chrome extension for page ruler, protractor, eyedropper, distance measurement, grid, and size inspection workflows.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/assets/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/assets/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "dist/icons/icon16.png",
    "32": "dist/icons/icon32.png",
    "48": "dist/icons/icon48.png",
    "128": "dist/icons/icon128.png"
  },
  "action": {
    "default_title": "Ruler",
    "default_popup": "dist/popup.html",
    "default_icon": {
      "16": "dist/icons/icon16.png",
      "32": "dist/icons/icon32.png",
      "48": "dist/icons/icon48.png",
      "128": "dist/icons/icon128.png"
    }
  },
  "web_accessible_resources": [{
    "resources": ["dist/assets/*"],
    "matches": ["<all_urls>"]
  }]
}
