{
  "name": "ruler-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Manifest V3 Chrome extension for page ruler and visual measurement workflows.",
  "scripts": {
    "build": "tsc --project tsconfig.json && vite build",
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "vite": "^7.0.0",
    "typescript": "^5.8.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@types/node": "^22.15.30"
  }
}
